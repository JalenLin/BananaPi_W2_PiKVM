# rtk_hdmirx asks for minor 250, but video_register_device() falls back to the
# first free number when it cannot have it, so the node name must not be
# hardcoded. Identify the device by the driver-specific sysfs attribute
# hdmirx_video_info instead, and map it to /dev/kvmd-video as kvmd's config
# expects.
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", \
    TEST=="/sys/class/video4linux/%k/hdmirx_video_info", \
    SYMLINK+="kvmd-video", GROUP="kvmd", MODE="0660"

# USB gadget HID. kvmd's otg plugin opens these fixed names, mirroring
# 99-kvmd.rules from upstream's platform package. With the combined HID (the
# default, see /usr/lib/kvmd/main.yaml) there is only hidg0, carrying both the
# keyboard and the mouse; with combined: false, hidg0 is the keyboard and
# hidg1 the mouse. There is never a hidg2 -- dwc3 does not have enough IN
# endpoints.
KERNEL=="hidg0", GROUP="kvmd", SYMLINK+="kvmd-hid-keyboard"
KERNEL=="hidg1", GROUP="kvmd", SYMLINK+="kvmd-hid-mouse"

# VE1, the CODA980 H.264 encoder (mainline kernel, coda driver). Its node
# number depends on probe order as well; ustreamer is pointed at this name
# with --h264-m2m-device. kvmd runs ustreamer as the kvmd user.
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", ATTR{name}=="coda-video-encoder", \
    SYMLINK+="kvmd-h264", GROUP="kvmd", MODE="0660"
