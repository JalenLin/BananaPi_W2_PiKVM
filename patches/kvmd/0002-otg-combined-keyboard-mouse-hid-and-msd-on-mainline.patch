--- a/kvmd/plugins/msd/otg/storage.py
+++ b/kvmd/plugins/msd/otg/storage.py
@@ -261,7 +261,7 @@ class Storage:
                 _check_image_name(name)
                 images[name] = await _make_image(file_path, name, True, (mnt_path != root_path))
 
-            if dir_path != root_path and os.path.ismount(dir_path):
+            if dir_path != root_path and fs.is_mountpoint(dir_path):
                 name = os.path.relpath(dir_path, root_path)
                 _check_image_name(name)
                 parts[name] = await _make_part(name, dir_path)
