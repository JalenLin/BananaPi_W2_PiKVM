From: BPI-W2 PiKVM <jalen.lin@gmail.com>
Subject: [PATCH] watchdog: rtd119x: add a restart handler

Nothing else can reset the RTD129x, so without one every reboot ends in

  reboot: Restarting system
  Reboot failed -- System halted

and the board needs a power cycle -- which defeats installing kernels over
the network. The sequence is the one in Realtek's BSP
(drivers/soc/realtek/rtd129x/rtd129x_restart.c).

diff --git a/drivers/watchdog/rtd119x_wdt.c b/drivers/watchdog/rtd119x_wdt.c
index 984905695..75a2c7584 100644
--- a/drivers/watchdog/rtd119x_wdt.c
+++ b/drivers/watchdog/rtd119x_wdt.c
@@ -8,6 +8,7 @@
 
 #include <linux/bitops.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
@@ -17,6 +18,7 @@
 #define RTD119X_TCWCR		0x0
 #define RTD119X_TCWTR		0x4
 #define RTD119X_TCWOV		0xc
+#define RTD119X_TCWRSTB_CNT	0x40
 
 #define RTD119X_TCWCR_WDEN_DISABLED		0xa5
 #define RTD119X_TCWCR_WDEN_ENABLED		0xff
@@ -76,12 +78,34 @@ static int rtd119x_wdt_set_timeout(struct watchdog_device *wdev, unsigned int va
 	return 0;
 }
 
+/*
+ * Nothing else can reset these SoCs: without this, reboot ends in
+ * "Reboot failed -- System halted". The sequence and counts are the ones
+ * Realtek's own kernel uses (rtd129x_restart.c): the watchdog fires after
+ * 0x800000 ticks of the 27 MHz clock, ~310 ms, and holds reset as long.
+ */
+static int rtd119x_wdt_restart(struct watchdog_device *wdev,
+			       unsigned long action, void *data)
+{
+	struct rtd119x_watchdog_device *wdt = watchdog_get_drvdata(wdev);
+
+	rtd119x_wdt_stop(wdev);
+	writel(0x00800000, wdt->base + RTD119X_TCWRSTB_CNT);
+	writel(RTD119X_TCWTR_WDCLR, wdt->base + RTD119X_TCWTR);
+	writel(0x00800000, wdt->base + RTD119X_TCWOV);
+	rtd119x_wdt_start(wdev);
+
+	mdelay(1000);
+	return 0;
+}
+
 static const struct watchdog_ops rtd119x_wdt_ops = {
 	.owner = THIS_MODULE,
 	.start		= rtd119x_wdt_start,
 	.stop		= rtd119x_wdt_stop,
 	.ping		= rtd119x_wdt_ping,
 	.set_timeout	= rtd119x_wdt_set_timeout,
+	.restart	= rtd119x_wdt_restart,
 };
 
 static const struct watchdog_info rtd119x_wdt_info = {
@@ -119,6 +143,7 @@ static int rtd119x_wdt_probe(struct platform_device *pdev)
 	data->wdt_dev.parent = dev;
 
 	watchdog_stop_on_reboot(&data->wdt_dev);
+	watchdog_set_restart_priority(&data->wdt_dev, 128);
 	watchdog_set_drvdata(&data->wdt_dev, data);
 	platform_set_drvdata(pdev, data);
 
