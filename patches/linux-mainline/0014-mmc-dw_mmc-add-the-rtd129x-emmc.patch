From: BPI-W2 PiKVM <jalen.lin@gmail.com>
Subject: [PATCH] mmc: dw_mmc: add the Realtek RTD129x eMMC

The RTD1295/RTD1296 eMMC controller is a DesignWare MSHC with a Realtek
wrapper. The glue, dw_mmc-rtd129x.c, is kept outside the kernel tree in
kernel/mainline and copied in by scripts/build-kernel-mainline.sh; these
lines hook it in.

diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index c94ae4794..f19128ea6 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -64,6 +64,19 @@ config MMC_PXA
 
 	  If unsure, say N.
 
+config MMC_SDMMC_RTD129X
+	tristate "Realtek RTD129x SD/MMC host"
+	depends on ARCH_REALTEK || COMPILE_TEST
+	select MFD_SYSCON
+	help
+	  Support for the SD card host on the Realtek RTD1295/RTD1296. The
+	  controller is the Realtek card reader core the rtsx drivers already
+	  handle, memory-mapped into the SoC instead of sitting behind PCIe or
+	  USB.
+
+	  Without it there is no SD card on these SoCs and the rootfs has to
+	  come from USB.
+
 config MMC_SDHCI
 	tristate "Secure Digital Host Controller Interface support"
 	depends on HAS_DMA
@@ -874,6 +887,16 @@ config MMC_DW_ROCKCHIP
 	  Synopsys DesignWare Memory Card Interface driver. Select this option
 	  for platforms based on RK3066, RK3188 and RK3288 SoC's.
 
+config MMC_DW_RTD129X
+	tristate "Realtek RTD129x specific extensions for Synopsys DW Memory Card Interface"
+	depends on ARCH_REALTEK || COMPILE_TEST
+	depends on MMC_DW
+	select MMC_DW_PLTFM
+	help
+	  This selects support for the eMMC controller of the Realtek
+	  RTD1295/RTD1296, a Synopsys DesignWare Memory Card Interface with
+	  a Realtek wrapper.
+
 config MMC_DW_STARFIVE
 	tristate "StarFive specific extensions for Synopsys DW Memory Card Interface"
 	depends on SOC_STARFIVE
diff --git a/drivers/mmc/host/Makefile b/drivers/mmc/host/Makefile
index 5057fea8a..bae45f0b7 100644
--- a/drivers/mmc/host/Makefile
+++ b/drivers/mmc/host/Makefile
@@ -11,6 +11,7 @@ obj-$(CONFIG_MMC_PXA)		+= pxamci.o
 obj-$(CONFIG_MMC_MXC)		+= mxcmmc.o
 obj-$(CONFIG_MMC_MXS)		+= mxs-mmc.o
 obj-$(CONFIG_MMC_SDHCI)		+= sdhci.o
+obj-$(CONFIG_MMC_SDMMC_RTD129X)	+= sdmmc-rtd129x.o
 obj-$(CONFIG_MMC_SDHCI_UHS2)	+= sdhci-uhs2.o
 obj-$(CONFIG_MMC_SDHCI_PCI)	+= sdhci-pci.o
 sdhci-pci-y			+= sdhci-pci-core.o sdhci-pci-o2micro.o sdhci-pci-arasan.o \
@@ -56,6 +57,7 @@ obj-$(CONFIG_MMC_DW_HI3798MV200) += dw_mmc-hi3798mv200.o
 obj-$(CONFIG_MMC_DW_K3)		+= dw_mmc-k3.o
 obj-$(CONFIG_MMC_DW_PCI)	+= dw_mmc-pci.o
 obj-$(CONFIG_MMC_DW_ROCKCHIP)	+= dw_mmc-rockchip.o
+obj-$(CONFIG_MMC_DW_RTD129X)	+= dw_mmc-rtd129x.o
 obj-$(CONFIG_MMC_DW_STARFIVE)	+= dw_mmc-starfive.o
 obj-$(CONFIG_MMC_SH_MMCIF)	+= sh_mmcif.o
 obj-$(CONFIG_MMC_JZ4740)	+= jz4740_mmc.o
