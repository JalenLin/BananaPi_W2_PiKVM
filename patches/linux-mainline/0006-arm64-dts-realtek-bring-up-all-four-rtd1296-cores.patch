From: BPI-W2 PiKVM <jalen.lin@gmail.com>
Subject: [PATCH] arm64: dts: realtek: bring up all four RTD1296 cores

rtd1296.dtsi declares four Cortex-A53s with no enable-method, so the kernel
brings up CPU0 and says so about the rest:

    /cpus/cpu@1: missing enable-method property
    smp: Brought up 1 node, 1 CPU

The release address is the same 0x9801aa44 the BSP uses. The BSP calls its
method "rtk-spin-table" only because it needed a different register access;
with the preceding patch the standard "spin-table" covers it.

diff --git a/arch/arm64/boot/dts/realtek/rtd1296.dtsi b/arch/arm64/boot/dts/realtek/rtd1296.dtsi
index 4f805f576..8c84082f8 100644
--- a/arch/arm64/boot/dts/realtek/rtd1296.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1296.dtsi
@@ -18,6 +18,8 @@ cpu0: cpu@0 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x0>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x9801aa44>;
 			next-level-cache = <&l2>;
 		};
 
@@ -25,6 +27,8 @@ cpu1: cpu@1 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x1>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x9801aa44>;
 			next-level-cache = <&l2>;
 		};
 
@@ -32,6 +36,8 @@ cpu2: cpu@2 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x2>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x9801aa44>;
 			next-level-cache = <&l2>;
 		};
 
@@ -39,6 +45,8 @@ cpu3: cpu@3 {
 			device_type = "cpu";
 			compatible = "arm,cortex-a53";
 			reg = <0x0 0x3>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x9801aa44>;
 			next-level-cache = <&l2>;
 		};
 
