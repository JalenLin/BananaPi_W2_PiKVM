+/* The inverse of out_color_to_bpp(), used by VIDIOC_G_FMT to report the
+   current format */
+static __u32 out_color_to_fourcc(MIPI_OUT_COLOR_SPACE_T output_color)
+{
+	switch (output_color) {
+	case OUT_8BIT_YUV422:
+		return V4L2_PIX_FMT_NV16;
+	case OUT_8BIT_YUV420:
+		return (mipi_top.uv_seq == UV_NV21) ?
+			V4L2_PIX_FMT_NV21 : V4L2_PIX_FMT_NV12;
+	case OUT_ARGB:
+		return V4L2_PIX_FMT_BGR32;
+	default:
+		return V4L2_PIX_FMT_NV16;
+	}
+}
+
+/* Pure validation, unlike V4L2_format_parse() which also mutates mipi_top */
+static bool fourcc_supported(__u32 fcc)
+{
+	switch (fcc) {
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV21:
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_BGR32:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Matches how hdmi_queue_setup() computes things, so userspace never sees an
+   inconsistent size */
+static void fill_pix_format(struct v4l2_pix_format *pix, unsigned int w,
+			    unsigned int h, MIPI_OUT_COLOR_SPACE_T color)
+{
+	int bpp = out_color_to_bpp(color);
+
+	memset(pix, 0, sizeof(*pix));
+	pix->width = w;
+	pix->height = h;
+	pix->pixelformat = out_color_to_fourcc(color);
+	pix->field = hdmi.tx_timing.progressive ?
+		V4L2_FIELD_NONE : V4L2_FIELD_INTERLACED;
+	pix->colorspace = V4L2_COLORSPACE_SRGB;
+
+	if (color >= OUT_ARGB) {
+		pix->bytesperline = w * bpp / 8;
+		pix->sizeimage = w * h * bpp / 8;
+	} else {
+		/* semi-planar: bytesperline refers to the Y plane's stride */
+		pix->bytesperline = roundup16(w);
+		pix->sizeimage = roundup16(w) * roundup16(h) * bpp / 8;
+	}
+}
