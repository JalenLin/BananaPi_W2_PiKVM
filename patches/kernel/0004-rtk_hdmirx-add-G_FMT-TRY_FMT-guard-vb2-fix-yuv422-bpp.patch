+int v4l2_mipi_top_release(struct file *filp)
+{
+	struct v4l2_hdmi_dev *dev = video_drvdata(filp);
+	int ret;
+
+	/*
+	 * vb2_fop_release() already does the whole teardown:
+	 *   - frees the queue and buffers when file->private_data == q->owner
+	 *   - finally calls v4l2_fh_release(), which del/exit/kfrees the
+	 *     v4l2_fh allocated at open and clears private_data
+	 *
+	 * So this must not touch v4l2_fh itself -- that would be a
+	 * use-after-free. All that is needed here is to reset the driver's own
+	 * flags.
+	 */
+	ret = vb2_fop_release(filp);
+	if (dev)
+		dev->queue_inited = false;
+
+	return ret;
+}
