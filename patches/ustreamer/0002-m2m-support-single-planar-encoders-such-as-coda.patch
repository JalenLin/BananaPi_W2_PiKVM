 	us_m2m_encoder_s *enc,
 	const us_frame_s *src,
@@ -192,6 +194,32 @@ static us_m2m_encoder_s *_m2m_encoder_init(
 		} \
 	}
 
+#define _IN_TYPE(x_run)		((x_run)->mplane ? V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE : V4L2_BUF_TYPE_VIDEO_OUTPUT)
+#define _OUT_TYPE(x_run)	((x_run)->mplane ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE : V4L2_BUF_TYPE_VIDEO_CAPTURE)
+
+static uint _m2m_buf_height(const us_frame_s *frame) {
+	// Capture hardware that aligns the plane height (1080 lines rounded up to
+	// 1088) starts the chroma plane after the padding rows, so the encoder has
+	// to be told the aligned height, and cropped back to the real one.
+	const uint aligned = (frame->height + 15) & ~15U;
+	uz size = 0;
+	switch (frame->format) {
+		case V4L2_PIX_FMT_NV12:
+		case V4L2_PIX_FMT_NV21:
+		case V4L2_PIX_FMT_YUV420:
+		case V4L2_PIX_FMT_YVU420:
+			size = (uz)frame->stride * aligned * 3 / 2;
+			break;
+		case V4L2_PIX_FMT_NV16:
+			size = (uz)frame->stride * aligned * 2;
+			break;
+	}
+	if (aligned != frame->height && size > 0 && frame->used >= size) {
+		return aligned;
+	}
+	return frame->height;
+}
