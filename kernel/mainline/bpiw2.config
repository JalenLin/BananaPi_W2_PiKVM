# Kconfig fragment merged onto arm64 defconfig by scripts/build-kernel-mainline.sh.
#
# arm64 defconfig is already a good base for this board -- it enables
# CONFIG_ARCH_REALTEK, the 8250/DesignWare UART the RTD1296 uses, and an
# initrd. What is here is either (a) restating something we depend on so a
# defconfig change upstream cannot silently take it away, or (b) bring-up
# comfort. Keep it short; anything board-specific that needs real work belongs
# in a patch or in the DTS, not here.

# --- the SoC ---------------------------------------------------------------
CONFIG_ARCH_REALTEK=y

# --- console ---------------------------------------------------------------
# u-boot passes "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200".
# uart0 is a snps,dw-apb-uart inside the ISO syscon block.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# The two peripheral interrupt muxes. Without them nothing below the GIC has
# an interrupt: uart0 probes with "IRQ index 0 not found" and runs polled.
CONFIG_REALTEK_RTD129X_IRQ_MUX=y

# USB host. arm64 defconfig already brings USB_DWC3, USB_DWC3_RTK, xhci,
# usb-storage, scsi and ext4; only the two Realtek phys need turning on, and
# they are what dwc3 waits for before it will probe.
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_PHY_RTK_RTD_USB3PHY=y

# --- kernel command line ---------------------------------------------------
# LK hands the kernel an empty command line. It overwrites /chosen/bootargs
# with its own idea of it on the way past, so neither the board DTS nor an
# `fdt set /chosen bootargs` in the LK console survives -- M0 saw
# "Kernel command line: " with nothing after it, and the console came up only
# because the board DTS sets stdout-path.
#
# So the command line is compiled in and forced. This is a bring-up
# expedient, not the end state: the BSP u-boot does set a proper bootargs
# (see docs/03), and if SD boot is ever usable on a board whose slot works,
# this should go back to CMDLINE_EXTEND or be dropped entirely.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200 loglevel=8 root=/dev/sda2 rootwait rw slub_debug=FZPU"
CONFIG_CMDLINE_FORCE=y

# --- memory corruption hunt (temporary) ------------------------------------
# Something writes over kernel memory a few seconds into userspace. It always
# surfaces in SLUB with a pointer from the 0x80000000 family -- the top of
# RAM -- but in a different place every boot, so the report is always far
# from the cause.
#
# slub_debug=FZPU adds redzones and poison around every object and records
# the allocating and freeing stack, so the *next* access reports which object
# was hit and who owned it.
#
# PAGE_POISONING and DEBUG_VM were tried alongside it and made things worse,
# not clearer: with page_poison=1 the kernel died in memblock_free_all before
# it ever reached userspace, which is the poisoning touching pages it should
# not rather than the bug we are chasing. slub_debug only touches slab
# objects, so it does not have that problem.
#
# Slow, and must come out once the cause is found.
CONFIG_SLUB_DEBUG=y
# keep_bootcon was here through M0-M1, when it was not yet certain 8250 would
# probe. It does, so earlycon can hand over; leaving it on prints every line
# twice, once from each console.
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# --- initramfs handed over by u-boot ---------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- bring-up comfort ------------------------------------------------------
# Timestamps make it possible to tell a hang from a slow probe, which is the
# single most common question during this work.
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=0

# --- version string --------------------------------------------------------
# Without this the build picks up "-dirty" from the vendor tree (the DTS is
# copied in and the Makefile is patched, so it is always dirty) and the
# version string changes depending on what the build script did last. Modules
# install under /lib/modules/<version>, so it needs to be stable.
CONFIG_LOCALVERSION="-bpiw2"
# CONFIG_LOCALVERSION_AUTO is not set
# (scripts/build-kernel-mainline.sh also exports LOCALVERSION="" -- both are
#  needed, see the comment there)
