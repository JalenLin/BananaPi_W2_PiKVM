# Kconfig fragment merged onto arm64 defconfig by scripts/build-kernel-mainline.sh.
#
# arm64 defconfig is already a good base for this board -- it enables
# CONFIG_ARCH_REALTEK, the 8250/DesignWare UART the RTD1296 uses, and an
# initrd. What is here is either (a) restating something we depend on so a
# defconfig change upstream cannot silently take it away, or (b) bring-up
# comfort. Keep it short; anything board-specific that needs real work belongs
# in a patch or in the DTS, not here.

# --- the SoC ---------------------------------------------------------------
CONFIG_ARCH_REALTEK=y

# --- console ---------------------------------------------------------------
# u-boot passes "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200".
# uart0 is a snps,dw-apb-uart inside the ISO syscon block.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# The two peripheral interrupt muxes. Without them nothing below the GIC has
# an interrupt: uart0 probes with "IRQ index 0 not found" and runs polled.
CONFIG_REALTEK_RTD129X_IRQ_MUX=y

# USB host. arm64 defconfig already brings USB_DWC3, USB_DWC3_RTK, xhci,
# usb-storage, scsi and ext4; only the two Realtek phys need turning on, and
# they are what dwc3 waits for before it will probe.
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_PHY_RTK_RTD_USB3PHY=y
# The CRT clock gates, which the USB controllers ask for (kernel/mainline/clk-rtd129x-crt.c).
CONFIG_COMMON_CLK_RTD129X_CRT=y

# kvmd-otg builds a configfs gadget with a HID keyboard and mouse on the
# Type-C port. arm64 defconfig has configfs gadgets, but as modules and
# without the HID function. kvmd-otg does not load libcomposite itself, so
# as a module /sys/kernel/config/usb_gadget never appears and it fails with
# ENOENT on its first mkdir. Built in, as the BSP kernel had it.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y

# The SD card host. Without it the rootfs has to live on USB, which is what
# M3 set up; this is what gets back to "flash a card and go".
CONFIG_MMC_SDMMC_RTD129X=y

# The onboard gigabit port. Built in rather than a module so the board is
# reachable over ssh even when /lib/modules does not match the kernel --
# which is the normal state while kernels are being swapped over the
# network.
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169SOC=y

# dev_dbg()/pr_debug() switchable at run time through
# /sys/kernel/debug/dynamic_debug/control. Bring-up of the SD host depends on
# seeing each command's result, and rebuilding to add printk()s costs a card
# swap per round.
CONFIG_DYNAMIC_DEBUG=y

# --- kernel command line ---------------------------------------------------
# LK hands the kernel an empty command line. It overwrites /chosen/bootargs
# with its own idea of it on the way past, so neither the board DTS nor an
# `fdt set /chosen bootargs` in the LK console survives -- M0 saw
# "Kernel command line: " with nothing after it, and the console came up only
# because the board DTS sets stdout-path.
#
# So the command line is compiled in and forced. This is a bring-up
# expedient, not the end state: the BSP u-boot does set a proper bootargs
# (see docs/03), and if SD boot is ever usable on a board whose slot works,
# this should go back to CMDLINE_EXTEND or be dropped entirely. The root is
# the SD card itself since M6.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200 loglevel=8 root=/dev/mmcblk0p2 rootwait rw"
CONFIG_CMDLINE_FORCE=y

# keep_bootcon was here through M0-M1, when it was not yet certain 8250 would
# probe. It does, so earlycon can hand over; leaving it on prints every line
# twice, once from each console.
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# --- initramfs handed over by u-boot ---------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- bring-up comfort ------------------------------------------------------
# Timestamps make it possible to tell a hang from a slow probe, which is the
# single most common question during this work.
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Recover without a human. Kernels now go onto the board over the network,
# and one that panics or locks up must not need someone to pull the power:
# panic reboots after 10 s (through the watchdog's restart handler, patch
# 0009), and a soft lockup or an oops counts as a panic. The serial console
# still has the whole trace, and from u-boot the previous kernel can be
# booted -- see docs/09 §9.
CONFIG_PANIC_TIMEOUT=10
CONFIG_PANIC_ON_OOPS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y

# --- version string --------------------------------------------------------
# Without this the build picks up "-dirty" from the vendor tree (the DTS is
# copied in and the Makefile is patched, so it is always dirty) and the
# version string changes depending on what the build script did last. Modules
# install under /lib/modules/<version>, so it needs to be stable.
CONFIG_LOCALVERSION="-bpiw2"
# CONFIG_LOCALVERSION_AUTO is not set
# (scripts/build-kernel-mainline.sh also exports LOCALVERSION="" -- both are
#  needed, see the comment there)

# --- HDMI input (M5) ---------------------------------------------------------
# kernel/mainline/hdmirx, Realtek's BSP driver. A module while it is being
# brought up, so a new build can be tried with rmmod/insmod instead of a
# reboot.
CONFIG_VIDEO_RTD129X_HDMIRX=m

# --- H.264 encoder ------------------------------------------------------------
# VE1 is a CODA980; the mainline coda driver runs it as a V4L2 mem2mem device
# (patch 0012), which is what ustreamer's --h264-sink encoder needs. A module,
# so the firmware can come from the rootfs.
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_CODA=m

# --- Landlock -------------------------------------------------------------
# pacman 7 downloads as the unprivileged alpm user inside a Landlock
# sandbox, and refuses to download at all without it ("restricting
# filesystem access failed because Landlock is not supported by the
# kernel"). arm64 defconfig leaves it out; CONFIG_LSM already lists it.
CONFIG_SECURITY_LANDLOCK=y

# --- HDMI input audio ------------------------------------------------------
# kernel/mainline/acpu: the RPC to the audio CPU's firmware, which owns the
# HDMI receiver's audio input, and an ALSA capture device on top of it.
CONFIG_RTD129X_ACPU=m
CONFIG_SND_RTD129X_HDMIRX=m

# --- eMMC ------------------------------------------------------------------
# kernel/mainline/dw_mmc-rtd129x.c on top of dw_mmc. Modules while the
# driver is being brought up (its DT node is disabled); built in once the
# root filesystem can be on the eMMC.
CONFIG_MMC_DW=m
CONFIG_MMC_DW_PLTFM=m
CONFIG_MMC_DW_RTD129X=m
