config RTD129X_ACPU
	tristate "Realtek RTD129x audio CPU RPC"
	depends on ARCH_REALTEK || COMPILE_TEST
	depends on OF
	select GENERIC_ALLOCATOR
	select AUXILIARY_BUS
	help
	  The RPC to the audio firmware that the BSP u-boot starts on the
	  RTD1295/RTD1296 audio CPU. The firmware owns the audio hardware,
	  including the HDMI receiver's audio input.

config SND_RTD129X_HDMIRX
	tristate "Realtek RTD129x HDMI receiver audio"
	depends on RTD129X_ACPU && SND
	select SND_PCM
	help
	  The audio of the RTD1295/RTD1296 HDMI input, captured by the audio
	  firmware, as an ALSA capture device.
