/*
 * Banana Pi BPI-W2 (Realtek RTD1296), 2 GiB variant
 *
 * Bring-up board file for the mainline/LTS kernel line. It is deliberately
 * minimal: mainline already carries rtd1296.dtsi, and the BSP's own
 * rtd-1296-bananapi-w2-2GB.dts is ~400 lines of vendor-only bindings that
 * have no driver here. Nodes get added back as each milestone in
 * docs/09-mainline-bringup.md is reached.
 *
 * Boot chain is unchanged: the BSP u-boot 2015.07 loads this DTB to
 * 0x02100000, the Image to 0x03000000 and the initramfs to 0x02200000, then
 * runs `booti`. u-boot writes both bootargs and linux,initrd-start/end into
 * /chosen itself, so neither is set here.
 */

/dts-v1/;

#include "rtd1296.dtsi"

/ {
	compatible = "bananapi,bpi-w2", "realtek,rtd1296";
	model = "Banana Pi BPI-W2";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Same 2 GiB layout as the DS418; the first 0x1f000 is boot ROM. */
	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x7ffe1000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The BSP u-boot loads bluecore.audio to CONFIG_FW_LOADADDR
		 * (0x0f900000, 4 MiB reserved) before handing over, and the
		 * audio CPU may already be fetching from it. Nothing on this
		 * kernel line uses the ACPU, but letting Linux allocate over a
		 * running core is not worth the debugging.
		 */
		acpu_fw: audio-firmware@f900000 {
			reg = <0x0f900000 0x00400000>;
			no-map;
		};

		/* ACPU_IDMEM_PHYS / ACPU_IDMEM_SIZE in the BSP's memory.h */
		/*
		 * The audio core's ION heap. `boot a` hands the ACPU its
		 * firmware and it runs alongside Linux from then on, writing
		 * here -- but mainline reserves nothing for it, so the page
		 * allocator hands the same 12 MiB out and the two scribble
		 * over each other. It shows up late and far from the cause,
		 * as a corrupted SLUB pointer:
		 *
		 *   Unable to handle kernel paging request at virtual address 0000000080000018
		 *   pc : put_cpu_partial+0x7c/0x140
		 *   Call trace: __slab_free / kfree / bucket_table_free_rcu
		 *
		 * Values from the BSP's ION_AUDIO_HEAP_PHYS/SIZE.
		 */
		acpu_audio_heap: audio-heap@2600000 {
			reg = <0x02600000 0x00c00000>;
			no-map;
		};

		/*
		 * The video firmware's ION heaps. The ACPU's video path runs
		 * the whole time -- VO_SetVideoStandard, HDMI infoframes --
		 * and writes here. Until these were reserved the kernel was
		 * loaded at 0x08000000, i.e. inside heap 1, so the firmware
		 * was writing over the kernel's own image and the memory
		 * after it. Values from ION_MEDIA_HEAP_PHYS1/SIZE1 and
		 * ION_MEDIA_HEAP_PHYS2/SIZE2 in the BSP.
		 */
		ion_media1: media-heap@3200000 {
			reg = <0x03200000 0x0b800000>;
			no-map;
		};

		ion_media2: media-heap@11000000 {
			reg = <0x11000000 0x09200000>;
			no-map;
		};

		/*
		 * The two regions the BSP u-boot hands the OS as /memreserve/
		 * entries before it jumps -- seen on the serial console as
		 *
		 *   reserving fdt memory region: addr=1f000 size=e1000
		 *   reserving fdt memory region: addr=1b00000 size=4be000
		 *
		 * LK adds neither. On the eMMC path FSBL puts the bootcode at
		 * 0x20000..0xb37e0 and starts BL31 and OP-TEE, and with only
		 * 0x20000..0x2ffff reserved here Linux handed the rest out;
		 * the page allocator then died a few seconds into userspace.
		 * rtd129x.dtsi already has 0x1f000..0x1ffff as rpc@1f000, so
		 * the first region starts after it.
		 */
		bootcode: bootcode@20000 {
			reg = <0x00020000 0x000e0000>;
			no-map;
		};

		fw_reserved: firmware@1b00000 {
			reg = <0x01b00000 0x004be000>;
			no-map;
		};

		acpu_idmem: acpu-idmem@10000000 {
			reg = <0x10000000 0x00014000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

/*
 * USB host ports.
 *
 * These belong in rtd129x.dtsi/rtd1296.dtsi eventually -- they describe the
 * SoC, not the board -- but they are still moving, and the board .dts is a
 * plain file while the .dtsi changes are patches. They move once they work.
 *
 * Addresses come from the BSP's rtd-129x-usb.dtsi, but the wrapper length
 * is 0x140, not the BSP's 0x200: the second reg entry (the pm control
 * register) sits at wrapper+0x160, so a 0x200 window swallows it and the
 * driver's own second request collides with its first --
 *   rtk-dwc3 98013c00.usb: error -EBUSY: can't request region for resource
 *   [mem 0x98013d60-0x98013d63]
 * which is why the upstream binding example uses 0x140.
 * Note the usb2phy reg
 * order is the reverse of the BSP's: mainline's binding is
 * <PHY data (wrapper)>, <PHY control (dwc3 core)>, and phy-rtk-usb2.c maps
 * index 0 to reg_wrap_vstatus and index 1 to reg_gusb2phyacc0.
 *
 * Port 0 is the Type-C/DRD port and port 2 is the EHCI/OHCI pair; neither is
 * here yet. Port 0 needs the extcon type-c driver to settle orientation, and
 * mainline has no driver for the BSP's "Realtek,rtd129x-ehci".
 *
 * Nothing here powers the ports: the BSP does that from its
 * "Realtek,usb-manager" through GPIOs, and mainline has no equivalent. When
 * booting by way of LK that does not matter, because LK has already run
 * `usb start` and left the clocks and port power on.
 */
&rbus {
	/*
	 * The SD card slot.
	 *
	 * Only the card reader core is claimed. The BSP's node also maps the
	 * CRT/PLL block, SB2 and the DMA engine shared with the eMMC
	 * controller, but the first three overlap nodes rtd129x.dtsi already
	 * has -- CRT is `crt: syscon@0`, which requests its region, so asking
	 * for it here fails:
	 *
	 *   rtd129x-sdmmc 98000000.mmc: error -EBUSY: can't request region for
	 *   resource [mem 0x98000000-0x980003ff]
	 *
	 * Nothing needs them yet: the clock generator this driver uses,
	 * CR_SD_CKGEN_CTL, is inside the core at offset 0x78. When a later
	 * stage needs the PLL it should reach it through a syscon phandle
	 * rather than a second mapping.
	 *
	 * No clocks or resets either: there is no clk or reset driver for this
	 * SoC in mainline and the driver treats both as optional, because the
	 * bootloader has already used this controller to read the kernel.
	 */
	sdmmc: mmc@10400 {
		compatible = "realtek,rtd1295-sdmmc";
		reg = <0x10400 0x200>;
		interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
		bus-width = <4>;
		cap-sd-highspeed;
	};

	/* Port 1: USB 2.0 host */
	usb_u2host_usb2phy: usb-phy@13c14 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x13c14 0x4>, <0x31280 0x4>;
		#phy-cells = <0>;
	};

	usb@13c00 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13c00 0x140>, <0x13d60 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		usb@29000 {
			compatible = "snps,dwc3";
			reg = <0x29000 0x9000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb_u2host_usb2phy>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
		};
	};

	/* Port 3: USB 3.0 host */
	usb_u3host_usb2phy: usb-phy@13e14 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x13e14 0x4>, <0x1f8280 0x4>;
		#phy-cells = <0>;
	};

	usb_u3host_usb3phy: usb-phy@13e10 {
		compatible = "realtek,rtd1295-usb3phy";
		reg = <0x13e10 0x4>;
		#phy-cells = <0>;
	};

	usb@13e00 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13e00 0x140>, <0x13f60 0x4>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		usb@1f0000 {
			compatible = "snps,dwc3";
			reg = <0x1f0000 0x9000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb_u3host_usb2phy>, <&usb_u3host_usb3phy>;
			phy-names = "usb2-phy", "usb3-phy";
			dr_mode = "host";
			snps,dis_u2_susphy_quirk;
		};
	};
};
