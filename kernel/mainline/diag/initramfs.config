# Diagnostic overlay for docs/09 §7 -- NOT for normal builds.
# Build with: EXTRA_CONFIG=kernel/mainline/diag/initramfs.config make kernel-mainline
#
# Userspace from a built-in initramfs, with every DMA source the kernel could
# drive switched off: no USB core, no dwc3, no SD host. slub_debug is off too,
# because it masked the fault rather than reporting it.
CONFIG_INITRAMFS_SOURCE="/work/build/diag/initramfs.cpio"
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200 loglevel=8 rdinit=/init usbcore.nousb initcall_blacklist=dwc3_driver_init,dwc3_rtk_driver_init,rtd129x_sdmmc_driver_init"
